# 部署用环境变量示例，复制为 deploy/.env 后填入真实值
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# 后端环境变量（与根目录 .env.example 一致，按需填写）
DATABASE_URL=mysql+pymysql://root:${MYSQL_ROOT_PASSWORD}@mysql:3306/goose_qa?charset=utf8mb4
DEEPSEEK_API_KEY=your_deepseek_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
VISION_PROVIDER=simulator
